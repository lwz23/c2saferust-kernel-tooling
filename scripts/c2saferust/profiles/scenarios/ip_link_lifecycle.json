{
  "schema_version": 1,
  "profile_type": "c2saferust-scenario-profile",
  "scenario_id": "ip_link_lifecycle",
  "runner_id": "qemu-scenario",
  "log_prefix": "smoke",
  "summary_fields": [
    "add_rc",
    "up_rc",
    "show_rc",
    "down_rc",
    "del_rc"
  ],
  "result_success_marker": "[smoke] RESULT=PASS",
  "script_lines": [
    "#!/bin/sh",
    "export PATH=/bin:/sbin",
    "mount -t proc proc /proc",
    "mount -t sysfs sysfs /sys",
    "mount -t devtmpfs devtmpfs /dev",
    "mkdir -p /dev/pts /tmp /run",
    "mknod /dev/console c 5 1 2>/dev/null || true",
    "mknod /dev/null c 1 3 2>/dev/null || true",
    "echo \"[{log_prefix}] begin lifecycle oracle\"",
    "echo \"[{log_prefix}] link_kind={link_kind}\"",
    "echo \"[{log_prefix}] device_name={device_name}\"",
    "ip link show >/tmp/ip-link-before.txt 2>&1",
    "ip link add {device_name} type {link_kind} >/tmp/ip-link-add.txt 2>&1",
    "add_rc=$?",
    "echo \"[{log_prefix}] add_rc=$add_rc\"",
    "if [ $add_rc -eq 0 ]; then",
    "    ip link set {device_name} up >/tmp/ip-link-up.txt 2>&1",
    "    up_rc=$?",
    "    echo \"[{log_prefix}] up_rc=$up_rc\"",
    "    ip link show {device_name} >/tmp/ip-link-show.txt 2>&1",
    "    show_rc=$?",
    "    echo \"[{log_prefix}] show_rc=$show_rc\"",
    "    ip link set {device_name} down >/tmp/ip-link-down.txt 2>&1",
    "    down_rc=$?",
    "    echo \"[{log_prefix}] down_rc=$down_rc\"",
    "    ip link del {device_name} >/tmp/ip-link-del.txt 2>&1",
    "    del_rc=$?",
    "    echo \"[{log_prefix}] del_rc=$del_rc\"",
    "else",
    "    up_rc=125",
    "    show_rc=125",
    "    down_rc=125",
    "    del_rc=125",
    "fi",
    "echo \"[{log_prefix}] before:\"",
    "cat /tmp/ip-link-before.txt",
    "echo \"[{log_prefix}] add:\"",
    "cat /tmp/ip-link-add.txt",
    "echo \"[{log_prefix}] show:\"",
    "[ -f /tmp/ip-link-show.txt ] && cat /tmp/ip-link-show.txt || true",
    "echo \"[{log_prefix}] dmesg-tail:\"",
    "dmesg | tail -n 120",
    "if [ $add_rc -eq 0 ] && [ $up_rc -eq 0 ] && [ $show_rc -eq 0 ] && [ $down_rc -eq 0 ] && [ $del_rc -eq 0 ]; then",
    "    echo \"[{log_prefix}] RESULT=PASS\"",
    "else",
    "    echo \"[{log_prefix}] RESULT=FAIL\"",
    "fi",
    "poweroff -f"
  ]
}
