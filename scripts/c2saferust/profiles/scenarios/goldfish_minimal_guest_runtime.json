{
  "schema_version": 1,
  "profile_type": "c2saferust-scenario-profile",
  "scenario_id": "goldfish_minimal_guest_runtime",
  "runner_id": "android-emulator-goldfish",
  "log_prefix": "goldfish-oracle",
  "summary_fields": [
    "open_rc",
    "ping_device_type_rc",
    "allocate_block_rc",
    "ping_allocate_rc",
    "mmap_rc",
    "invalid_mmap_rc",
    "claim_shared_rc",
    "unclaim_shared_rc",
