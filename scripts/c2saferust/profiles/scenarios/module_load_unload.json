{
  "schema_version": 1,
  "profile_type": "c2saferust-scenario-profile",
  "scenario_id": "module_load_unload",
  "runner_id": "qemu-module-lifecycle",
  "log_prefix": "oracle",
  "summary_fields": [
    "insmod_rc",
    "load_visible_rc",
    "rmmod_rc",
    "unload_absent_rc"
  ],
  "result_success_marker": "[oracle] RESULT=PASS",
  "script_lines": [
    "#!/bin/sh",
    "export PATH=/bin:/sbin",
    "mount -t proc proc /proc",
    "mount -t sysfs sysfs /sys",
    "mount -t devtmpfs devtmpfs /dev",
    "mkdir -p /dev/pts /tmp /run /modules",
    "mknod /dev/console c 5 1 2>/dev/null || true",
    "mknod /dev/null c 1 3 2>/dev/null || true",
    "echo \"[{log_prefix}] begin module lifecycle oracle\"",
    "echo \"[{log_prefix}] module_name={module_name}\"",
    "echo \"[{log_prefix}] module_file=/modules/{module_file_name}\"",
    "insmod /modules/{module_file_name} >/tmp/insmod.txt 2>&1",
    "insmod_rc=$?",
    "echo \"[{log_prefix}] insmod_rc=$insmod_rc\"",
    "if [ $insmod_rc -eq 0 ]; then",
    "    if [ -d /sys/module/{module_name} ]; then",
    "        load_visible_rc=0",
    "    else",
    "        load_visible_rc=1",
    "    fi",
    "    rmmod {module_name} >/tmp/rmmod.txt 2>&1",
    "    rmmod_rc=$?",
    "    if [ ! -d /sys/module/{module_name} ]; then",
    "        unload_absent_rc=0",
    "    else",
    "        unload_absent_rc=1",
    "    fi",
    "else",
    "    load_visible_rc=125",
    "    rmmod_rc=125",
    "    unload_absent_rc=125",
    "fi",
    "echo \"[{log_prefix}] load_visible_rc=$load_visible_rc\"",
    "echo \"[{log_prefix}] rmmod_rc=$rmmod_rc\"",
    "echo \"[{log_prefix}] unload_absent_rc=$unload_absent_rc\"",
    "echo \"[{log_prefix}] insmod:\"",
    "cat /tmp/insmod.txt",
    "echo \"[{log_prefix}] rmmod:\"",
    "[ -f /tmp/rmmod.txt ] && cat /tmp/rmmod.txt || true",
    "echo \"[{log_prefix}] dmesg-tail:\"",
    "dmesg | tail -n 120",
    "if [ $insmod_rc -eq 0 ] && [ $load_visible_rc -eq 0 ] && [ $rmmod_rc -eq 0 ] && [ $unload_absent_rc -eq 0 ]; then",
    "    echo \"[{log_prefix}] RESULT=PASS\"",
    "else",
    "    echo \"[{log_prefix}] RESULT=FAIL\"",
    "fi",
    "poweroff -f"
  ]
}
