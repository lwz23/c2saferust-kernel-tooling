{
  "schema_version": 1,
  "profile_type": "c2saferust-module-profile",
  "profile_id": "rnull_blind_strict_v1",
  "family_id": "block-null",
  "rule_pack_ids": [
    "block_null_core_safety"
  ],
  "module_path": "drivers/block/null_blk/main.c",
  "module_id": "rnull_blind_strict_v1",
  "artifact_dir": "Documentation/rust/c2saferust/rnull_blind_strict_v1",
  "driver_rust_path": "drivers/block/rnull/rnull.rs",
  "landing": {
    "module_dir": "drivers/block/rnull",
    "driver_rust_path": "drivers/block/rnull/rnull.rs",
    "kconfig_path": "drivers/block/rnull/Kconfig",
    "makefile_path": "drivers/block/rnull/Makefile"
  },
  "kbuild": {
    "mode": "add-new-driver",
    "driver_config_symbol": "BLK_DEV_RUST_NULL",
    "driver_object": "rnull_mod.o",
    "driver_prompt": "Rust null block driver (Experimental)",
    "driver_depends_on": "RUST && CONFIGFS_FS",
    "driver_help": [
      "Build the Rust implementation of the null block driver.",
      "This target is used for the strict blind-first `null_blk` migration experiment."
    ],
    "reference_pattern": {
      "kconfig_path": "drivers/block/rnull/Kconfig",
      "makefile_path": "drivers/block/rnull/Makefile",
      "rust_driver_path": "drivers/block/rnull/rnull.rs"
    }
  },
  "build_validation": {
    "module_lifecycle_config": {
      "artifact_filename": "module-lifecycle.config",
      "required_config_lines": [
        "CONFIG_MODULES=y",
        "CONFIG_BLOCK=y",
        "CONFIG_RUST=y",
        "CONFIG_CONFIGFS_FS=y",
        "CONFIG_BLK_DEV_RUST_NULL=m"
      ]
    }
  },
  "external_header_decisions": {
    "null_blk.h": {
      "action": "ignore_private_header",
      "reason": "The blind-first workflow must stay within the block-mq/configfs abstraction subset instead of translating the private `null_blk.h` helper surface.",
      "required_symbols": [],
      "mvp_blocking": false,
      "rust_strategy": "Model the required behavior through block-mq/configfs artifacts and generic Rust abstractions instead of landing this private header."
    }
  },
  "translation": {
    "goal": "Constrain a strict blind-first `drivers/block/rnull/rnull.rs` candidate from `drivers/block/null_blk/main.c` without reading the official Rust implementation body, producing a standalone Rust null block driver candidate that stays inside the artifact-defined block/configfs subset.",
    "abstraction_goal": "Only allow block-mq plus configfs safe abstractions; driver code must remain free of `unsafe`, `bindings::*`, `extern \"C\"`, raw pointers, and deferred lifecycle callbacks.",
    "mvp_scope": {
      "target_command": "make ... drivers/block/rnull/rnull_mod.o && make ... drivers/block/rnull/rnull_mod.ko",
      "note": "This blind-first phase targets build plus QEMU module load/unload validation first; richer configfs behavior validation remains deferred."
    },
    "required_callback_fields": [
      {
        "source": "blk_mq_ops",
        "field": "queue_rq"
      },
      {
        "source": "blk_mq_ops",
        "field": "complete"
      },
      {
        "source": "configfs_group_operations",
        "field": "make_group"
      },
      {
        "source": "configfs_show",
        "field": "features"
      },
      {
        "source": "configfs_show",
        "field": "power"
      },
      {
        "source": "configfs_store",
        "field": "power"
      },
      {
        "source": "configfs_show",
        "field": "blocksize"
      },
      {
        "source": "configfs_store",
        "field": "blocksize"
      },
      {
        "source": "configfs_show",
        "field": "rotational"
      },
      {
        "source": "configfs_store",
        "field": "rotational"
      },
      {
        "source": "configfs_show",
        "field": "size"
      },
      {
        "source": "configfs_store",
        "field": "size"
      },
      {
        "source": "configfs_show",
        "field": "irqmode"
      },
      {
        "source": "configfs_store",
        "field": "irqmode"
      }
    ],
    "deferred_callback_fields": [
      {
        "source": "configfs_group_operations",
        "field": "drop_item"
      },
      {
        "source": "configfs_item_operations",
        "field": "release"
      }
    ],
    "callback_roles": {
      "blk_mq_ops.queue_rq": {
        "status": "required",
        "rust_surface": "typed `block::mq::Operations::queue_rq` implementation",
        "body_plan": [
          "Map the queue callback to a safe `block::mq::Operations` implementation using queue-owned Rust state only.",
          "Preserve the split between synchronous completion and deferred completion without exposing raw request ownership to driver code."
        ]
      },
      "blk_mq_ops.complete": {
        "status": "required",
        "rust_surface": "typed `block::mq::Operations::complete` implementation",
        "body_plan": [
          "Finish asynchronously completed requests through the typed Rust request API only.",
          "Keep the final request reference and completion bookkeeping inside the abstraction-owned request type."
        ]
      },
      "configfs_group_operations.make_group": {
        "status": "required",
        "rust_surface": "typed `configfs::GroupOperations::make_group` implementation",
        "body_plan": [
          "Create the per-device configfs group through `configfs::Group::new` and owned Rust state.",
          "Seed the MVP subset fields (`power`, `block_size`, `rotational`, `capacity_mib`, `irq_mode`, `disk`) inside an owned mutex-backed Rust struct."
        ]
      },
      "configfs_show.features": {
        "status": "required",
        "rust_surface": "typed `configfs::AttributeOperations::show` implementation",
        "body_plan": [
          "Report the supported configfs blind-first attributes as a static text list through a typed page writer."
        ]
      },
      "configfs_show.power": {
        "status": "required",
        "rust_surface": "typed `configfs::AttributeOperations::show` implementation",
        "body_plan": [
          "Render the current powered state from owned Rust state without exposing raw configfs data pointers."
        ]
      },
      "configfs_store.power": {
        "status": "required",
        "rust_surface": "typed `configfs::AttributeOperations::store` implementation",
        "body_plan": [
          "Translate power-on into disk creation and store the resulting disk inside owned Rust state.",
          "Translate power-off into dropping the owned disk handle plus state update, keeping teardown best-effort and owned."
        ]
      },
      "configfs_show.blocksize": {
        "status": "required",
        "rust_surface": "typed `configfs::AttributeOperations::show` implementation",
        "body_plan": [
          "Expose the configured block size through a typed formatter."
        ]
      },
      "configfs_store.blocksize": {
        "status": "required",
        "rust_surface": "typed `configfs::AttributeOperations::store` implementation",
        "body_plan": [
          "Reject writes while powered, validate block size through the safe block builder surface, and then update owned Rust state."
        ]
      },
      "configfs_show.rotational": {
        "status": "required",
        "rust_surface": "typed `configfs::AttributeOperations::show` implementation",
        "body_plan": [
          "Expose the current rotational flag through a typed formatter."
        ]
      },
      "configfs_store.rotational": {
        "status": "required",
        "rust_surface": "typed `configfs::AttributeOperations::store` implementation",
        "body_plan": [
          "Reject writes while powered and update the typed boolean configuration through a safe parsing helper."
        ]
      },
      "configfs_show.size": {
        "status": "required",
        "rust_surface": "typed `configfs::AttributeOperations::show` implementation",
        "body_plan": [
          "Expose the configured capacity in MiB through a typed formatter."
        ]
      },
      "configfs_store.size": {
        "status": "required",
        "rust_surface": "typed `configfs::AttributeOperations::store` implementation",
        "body_plan": [
          "Reject writes while powered and parse the configured capacity into owned Rust state."
        ]
      },
      "configfs_show.irqmode": {
        "status": "required",
        "rust_surface": "typed `configfs::AttributeOperations::show` implementation",
        "body_plan": [
          "Expose the current IRQ mode through a typed Rust enum formatter."
        ]
      },
      "configfs_store.irqmode": {
        "status": "required",
        "rust_surface": "typed `configfs::AttributeOperations::store` implementation",
        "body_plan": [
          "Reject writes while powered, parse the mode as an integer, and convert it through a typed Rust enum."
        ]
      }
    },
    "driver_generation_rules": [
      "Read only the generated experiment artifacts plus the allowlisted generic block/configfs abstraction files before writing driver code.",
      "Do not read `drivers/block/rnull/rnull.rs` or `drivers/block/rnull/configfs.rs`.",
      "Do not use `git show` on `drivers/block/rnull/rnull.rs` or `drivers/block/rnull/configfs.rs`.",
      "Treat `translation-plan.json` and `agent-workflow-plan.json` as the prompt sources; do not search for extra hidden prompt artifacts.",
      "If the abstraction mapping is still ambiguous after reading the artifacts, stop and record a planner/profile gap instead of filling it with driver-side `unsafe`."
    ],
    "additional_allowed_driver_surfaces": [
      "kernel::configfs::Group",
      "kernel::str::Formatter",
      "kernel::error::code::EIO"
    ],
    "additional_forbidden_driver_calls": [
      "bindings::blk_mq_requeue_request",
      "bindings::config_item_put",
      "bindings::configfs_add_default_group"
    ],
    "module_shell": {
      "module_macro_required": true,
      "preferred_driver_type": "RustNullDevice",
      "preferred_module_macro": "module!",
      "device_table": [],
      "drivers": [
        "RustNullModule",
        "RustNullDevice",
        "DeviceConfig"
      ],
      "module_name": "rnull_mod"
    },
    "private_state": {
      "type_name": "DeviceConfigState",
      "layout": "Configfs-owned device state guarded by a Rust mutex, with the created disk owned as `Option<GenDisk<RustNullDevice>>`.",
      "fields": [
        {
          "name": "powered",
          "rust_type": "bool",
          "role": "Track whether the configfs device is currently powered on."
        },
        {
          "name": "name",
          "rust_type": "CString",
          "role": "Persist the configfs device name for disk creation."
        },
        {
          "name": "block_size",
          "rust_type": "u32",
          "role": "Own the configured logical/physical block size."
        },
        {
          "name": "rotational",
          "rust_type": "bool",
          "role": "Own the rotational queue property."
        },
        {
          "name": "capacity_mib",
          "rust_type": "u64",
          "role": "Own the configured capacity."
        },
        {
          "name": "irq_mode",
          "rust_type": "IRQMode",
          "role": "Own the MVP IRQ completion mode."
        },
        {
          "name": "disk",
          "rust_type": "Option<GenDisk<RustNullDevice>>",
          "role": "Own the live disk while powered on and drop it during power-off or group teardown."
        }
      ],
      "note": "The blind-first subset keeps per-device state entirely on the configfs side; advanced null_blk runtime state stays outside this phase."
    },
    "driver_shape": {
      "driver_traits": [
        "impl Operations for RustNullDevice",
        "impl configfs::GroupOperations for Config",
        "impl AttributeOperations<0> for Config",
        "impl AttributeOperations<0..=4> for DeviceConfig"
      ],
      "module_registration": "module!",
      "module_struct": "RustNullModule",
      "queue_data_type": "KBox<QueueData>"
    },
    "state_mapping": {
      "c_private_state": {
        "struct_name": "nullb_device",
        "fields": [
          "power",
          "blocksize",
          "rotational",
          "size",
          "irqmode"
        ]
      },
      "rust_policy_state": {
        "type_name": "DeviceConfigState",
        "fields": [
          "powered",
          "block_size",
          "rotational",
          "capacity_mib",
          "irq_mode",
          "disk"
        ]
      }
    },
    "runtime_expectation": {
      "validation_mode": "qemu-module-lifecycle",
      "scope": "build plus module load/unload only in the first blind-first pass",
      "claim": "lifecycle_validated"
    }
  },
  "oracle": {
    "runner_id": "qemu-module-lifecycle",
    "scenario_id": "module_load_unload",
    "scenario_inputs": {
      "module_name": "rnull_mod",
      "module_file_relpath_template": "drivers/block/rnull/rnull_mod.ko",
      "module_file_name_template": "rnull_mod.ko"
    }
  },
  "agent_workflow": {
    "topology": {
      "agent_count": 3,
      "mode": "orchestrated-handoff",
      "roles": [
        {
          "id": "coder",
          "owned_files": [
            "drivers/block/rnull/rnull.rs",
            "drivers/block/rnull/configfs.rs"
          ],
          "must_follow": [
            "#![forbid(unsafe_code)]",
            "no bindings::*",
            "no raw pointers",
            "no deferred callback implementation"
          ]
        },
        {
          "id": "reviewer",
          "owned_scope": [
            "callback coverage",
            "blind hygiene",
            "safety policy",
            "abstraction boundary review"
          ],
          "must_check": [
            "queue/completion parity",
            "configfs lifecycle parity",
            "no reference leakage"
          ]
        },
        {
          "id": "builder",
          "owned_scope": [
            "verify-safety",
            "gate-agent-candidate",
            "QEMU lifecycle runner"
          ],
          "must_use_build_dir": "/tmp/c2saferust-rnull-build"
        }
      ]
    },
    "phase_workflow": [
      "phase0-intake-freeze",
      "phase1-context",
      "phase2-translation-plan",
      "phase3-codegen",
      "phase4-review",
      "phase5-build-runtime",
      "phase6-freeze-diff"
    ],
    "failure_buckets": [
      "candidate-bug",
      "planner-profile-gap",
      "abstraction-tooling-gap",
      "environment-benchmark-gap"
    ]
  }
